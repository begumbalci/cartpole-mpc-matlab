%Day 5 changing the initial position and not only
%stabilize the pole but move to the desired postiion
clc;
close all;
load('cart_pole_system.mat');
ssteps=100;

x_current=[0;0;0.1;0];

%we want pole to be in the desired position without falling

x_ref=[0.5 ; 0; 0; 0];
X_ref = repmat(x_ref,N,1);

H = 2*(Phi'* Qbar * Phi +Rbar);
H = (H + H')/2;
options = optimoptions('quadprog','Display','off');

x_history = zeros(n,ssteps+1);
u_history = zeros(m_in, ssteps);
t_history = (0:ssteps)*Ts;
x_history(:,1) = x_current;

for step = 1:ssteps
   f = 2 * Phi' * Qbar * (M * x_current - X_ref);
   [U_opt, ~, exitflag] = quadprog(H, f, [], [], [], [], [], [], [], options);
       if exitflag ~= 1
           warning('QP failed at step %d, stopping simulation', step);
           break;
       end

    %Take the first control input   
    u0 = U_opt(1:m_in);

    x_next = A * x_current + B * u0;

    %Store the results
    u_history(:,step)=u0;
    x_history(:,step+1) = x_next;
    x_current = x_next;
end
disp('Day 5 simulation finished');

figure;

subplot(3,1,1);
plot(t_history, x_history(1,:), '-');
yticks(0:0.1:0.5);
xlabel('Time (s)');
ylabel('Cart position (m)');
title('Cart position');
grid on;

subplot(3,1,2);
plot(t_history, x_history(3,:), '-');
xlabel('Time (s)');
ylabel('Pole angle (rad)');
title('Pole angle');
grid on;

subplot(3,1,3);
stairs(t_history(1:end-1), u_history(1,:), '-');
xlabel('Time (s)');
ylabel('Force (N)');
title('Control force');
grid on;
