
load('cart_pole_system.mat');
N =10;
n = size(A,1);
m_in=size(B,2);

M = zeros(N*n,n);

Phi = zeros(N*n, N*m_in);

% initialize power of A for the loop starting from Aˆ1

A_power = eye(n);
for i=1:N
    A_power=A_power*A;
    row_idx=(i-1)*n+1:i*n;
    M(row_idx,:) = A_power;
end

Phi = zeros(N*n, N*m_in);
    
 for row = 1:N
     row_idx = (row-1)*n + 1 : row*n;
        for col = 1:row
            col_idx = (col-1)*m_in + 1 : col*m_in;
            power = row - col;
            Phi(row_idx, col_idx) = A^power * B;
        end
 end
fprintf('M size: %d x %d\n', size(M,1), size(M,2));
fprintf('Phi size: %d x %d\n', size(Phi,1), size(Phi,2));

%% 6. Save Output
save('cart_pole_system.mat');
